#ifndef __ONES_BANG_INTERNAL_H__
#define __ONES_BANG_INTERNAL_H__

#include "../../../elementwise/bang/elementwise_bang_kernel.h"

typedef struct OnesOp {
public:
    static constexpr size_t num_inputs = 1;
    template <typename T>
    __mlu_device__ void operator()(T *out, const T *input, const T *unused, size_t num_elements) const {
        (void)input;
        (void)unused;
        if constexpr (std::is_same_v<T, double>) {
            for (size_t i = 0; i < num_elements; ++i) {
                out[i] = 1.0;
            }
        } else {
            __bang_write_value(out, num_elements, static_cast<T>(1));
        }
    }
} OnesOp;

LAUNCH_ELEMENTWISE_KERNEL_IMPL(Ones, OnesOp)

LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, uint8_t)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, bool)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, int8_t)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, int16_t)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, int32_t)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, int64_t)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, uint16_t)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, uint32_t)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, uint64_t)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, half)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, float)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, double)
LAUNCH_ELEMENTWISE_KERNEL_INSTANTIATE(Ones, bfloat16_t)

#endif // __ONES_BANG_INTERNAL_H__
